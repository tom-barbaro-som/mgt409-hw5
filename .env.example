# Copy this file to .env (in this hw5/ folder) and fill in your own key:
#   cp .env.example .env
# .env is git-ignored. Never commit a real key.

# Portkey gateway key used for every agent call (OpenAI-compatible, Responses API)
PORTKEY_API_KEY=your-portkey-api-key-here

# The only model this project allows
OPENAI_MODEL=gpt-6-luna

# Optional
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=          # leave empty if your key has a default provider attached
# OPENAI_REASONING_EFFORT=low
# TICKET_TOKEN_BUDGET=150000 # per-ticket AI budget before a human must approve more
